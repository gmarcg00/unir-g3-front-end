      "updated": 1733330577554,
      "link": null,
      "locked": false,
      "fontSize": 40.07112928997934,
      "fontFamily": 1,
      "text": "• Parte privada a la que accederán profesores, alumnos y administrador,\n donde cada uno podrá ver un menú de acceso a su secciones en función de su role.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Parte privada a la que accederán profesores, alumnos y administrador,\n donde cada uno podrá ver un menú de acceso a su secciones en función de su role.",
      "lineHeight": 1.25,
      "baseline": 85,
      "index": "a8",
      "autoResize": true
    },
    {
      "type": "text",
      "version": 743,
      "versionNonce": 2043735269,
      "isDeleted": false,
      "id": "HBSZA5ciV1gBP__xrh3Wo",
