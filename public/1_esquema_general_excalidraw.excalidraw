      "updated": 1733330577554,
      "link": null,
      "locked": false,
      "fontSize": 40.07112928997934,
      "fontFamily": 1,
      "text": "• Los administradores podrán ver el listado de alumnos y darlos de baja \n(baja lógica no borrarlos).",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Los administradores podrán ver el listado de alumnos y darlos de baja \n(baja lógica no borrarlos).",
      "lineHeight": 1.25,
      "baseline": 85,
      "index": "a9",
      "autoResize": true
    },
